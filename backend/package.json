{
  "name": "drawdb-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:create": "wrangler d1 create drawdb-db",
    "d1:init:local": "wrangler d1 execute drawdb-db --local --file=./schema.sql -y",
    "d1:init:remote": "wrangler d1 execute drawdb-db --remote --file=./schema.sql -y"
  },
  "dependencies": {
    "hono": "^4.7.4",
    "nanoid": "^5.1.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "typescript": "^5.7.3",
    "wrangler": "^3.114.0"
  }
}
